# =============================================================================
# POS PLATFORM — Backend API Environment Variables
# Copy to .env and fill in all values before running
# =============================================================================

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# PostgreSQL (Cloud DB)
PG_HOST=your-postgres-host
PG_PORT=5432
PG_DATABASE=pos_platform
PG_USER=pos_api
PG_PASSWORD=CHANGE_ME_STRONG_PG_PASSWORD
PG_POOL_MAX=20
PG_SSL_CA=        # Path to CA cert PEM for SSL mutual auth (production)

# Redis
REDIS_URL=redis://localhost:6379

# JWT (RS256 asymmetric keys)
# Generate: openssl genrsa -out private.pem 4096 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Handshake HMAC secret (used to sign offline grace-period tokens for C++ client)
# Must be 64+ random bytes, base64 or hex encoded
HANDSHAKE_HMAC_SECRET=CHANGE_ME_64_RANDOM_BYTES_HEX

# Sync endpoint HMAC secret (used to verify C++ client request signatures)
SYNC_HMAC_SECRET=CHANGE_ME_ANOTHER_64_RANDOM_BYTES

# Admin Dashboard CORS origin
ADMIN_DASHBOARD_ORIGIN=https://admin.yourdomain.com

# Stripe (for subscription billing)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
