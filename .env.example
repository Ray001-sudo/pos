# =============================================================================
# POS Platform — Root .env (docker-compose secrets)
# Copy to .env and fill in all values
# =============================================================================

# PostgreSQL
PG_PASSWORD=CHANGE_ME_STRONG_PG_PASSWORD

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# JWT RSA Keys (RS256)
# Generate:
#   openssl genrsa -out private.pem 4096
#   openssl rsa -in private.pem -pubout -out public.pem
#   Then paste PEM content here with \n line endings
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# HMAC secrets (64+ random hex bytes each)
# Generate: openssl rand -hex 64
HANDSHAKE_HMAC_SECRET=CHANGE_ME_HANDSHAKE_HMAC_64HEX
SYNC_HMAC_SECRET=CHANGE_ME_SYNC_HMAC_64HEX

# Dashboard CORS origin
ADMIN_DASHBOARD_ORIGIN=https://admin.yourdomain.com || http://localhost:3000
